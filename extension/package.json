{
  "name": "pico-chat",
  "displayName": "Team Pico Chat",
  "description": "Pico, a coding agent for VS Code",
  "version": "0.0.0",
  "opencodeCliVersion": "2.4.0",
  "publisher": "TeamPico",
  "repository": {
    "type": "git",
    "url": "https://github.com/It-s-Study-5/my-copilot.git"
  },
  "license": "MIT",
  "icon": "media/pico_icon_1024.jpg",
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "opencode",
          "title": "Pico",
          "icon": "media/pico.svg"
        }
      ]
    },
    "views": {
      "opencode": [
        {
          "type": "webview",
          "id": "opencode.chat",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "Pico",
      "properties": {
        "opencode.cliPath": {
          "type": "string",
          "default": "",
          "description": "비워 두면 지정된 버전의 서버용 CLI를 처음 한 번 자동으로 내려받습니다. 직접 빌드한 CLI를 쓰려면 실행 파일의 전체 경로를 지정하세요."
        },
        "opencode.serverUrl": {
          "type": "string",
          "default": "",
          "description": "비워 두면 서버용 CLI로 로컬 백그라운드 서버를 자동 실행하거나 재사용합니다. 직접 연결하려면 HTTP(S) 주소를 지정하세요. 비밀번호는 주소에 포함하지 마세요."
        },
        "opencode.inlineCompletion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "입력이나 커서 이동을 멈추면 주변 코드와 함께 Pico가 연결된 서버에 인라인 자동완성을 요청합니다."
        },
        "opencode.inlineCompletion.delayMs": {
          "type": "integer",
          "default": 1000,
          "minimum": 250,
          "maximum": 10000,
          "description": "자동완성을 요청하기 전 대기 시간(밀리초)입니다."
        }
      }
    },
    "commands": [
      {
        "command": "opencode.openChat",
        "title": "Open Pico Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "opencode.openTerminal",
        "title": "Open Pico Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "opencode.openNewTerminal",
        "title": "Open Pico Terminal in New Tab",
        "icon": "$(terminal)"
      },
      {
        "command": "opencode.addFilepathToTerminal",
        "title": "Add Filepath to Terminal"
      },
      {
        "command": "opencode.analyzeImpact",
        "title": "Code Impact: 이 함수의 변경 영향도 분석"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "opencode.openChat",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "opencode.openChat",
        "title": "Run Pico",
        "key": "cmd+escape",
        "mac": "cmd+escape",
        "win": "ctrl+escape",
        "linux": "ctrl+escape"
      },
      {
        "command": "opencode.openNewTerminal",
        "title": "Run Pico",
        "key": "cmd+shift+escape",
        "mac": "cmd+shift+escape",
        "win": "ctrl+shift+escape",
        "linux": "ctrl+shift+escape"
      },
      {
        "command": "opencode.addFilepathToTerminal",
        "title": "Pico: Insert File Reference",
        "key": "cmd+alt+k",
        "mac": "cmd+alt+k",
        "win": "ctrl+alt+K",
        "linux": "ctrl+alt+K"
      },
      {
        "command": "opencode.analyzeImpact",
        "key": "ctrl+alt+shift+i",
        "mac": "ctrl+alt+i",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "bun run package",
    "compile": "bun run check-types && bun run lint && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "bun run check-types && bun run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "bun run compile-tests && bun run compile && bun run lint",
    "check-types": "tsc --noEmit",
    "test:unit": "bun test --timeout 10000 ./test",
    "test:server": "bun run test/real-server.ts",
    "test:chat": "bun run test/real-chat.ts",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.94.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "esbuild": "^0.25.3",
    "typescript": "^5.8.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  },
  "dependencies": {
    "@opencode/client": "2.4.0"
  }
}
